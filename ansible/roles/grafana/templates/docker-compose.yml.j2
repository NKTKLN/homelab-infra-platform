# {{ ansible_managed }}
services:
  grafana:
    image: {{ grafana_image }}
    container_name: {{ grafana_container_name }}
    restart: unless-stopped
    user: "{{ grafana_run_uid }}:{{ grafana_run_gid }}"
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP={{ grafana_allow_sign_up | lower }}
      - GF_SERVER_HTTP_PORT=3000
    volumes:
      - ./provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ grafana_bind_ip }}:{{ grafana_port }}:3000"
    networks:
      - monitoring

volumes:
  grafana-data:

# External: created by the prometheus role's compose project. Lets Grafana
# reach Prometheus/Alertmanager by container name across compose stacks.
networks:
  monitoring:
    external: true
    name: monitoring
