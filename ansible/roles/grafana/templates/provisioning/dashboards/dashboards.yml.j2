# {{ ansible_managed }}
apiVersion: 1

providers:
  - name: homelab
    orgId: 1
    folder: "{{ grafana_dashboards_folder }}"
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: /etc/grafana/provisioning/dashboards/json
      foldersFromFilesStructure: false
