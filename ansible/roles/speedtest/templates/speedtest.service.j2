# {{ ansible_managed }}
[Unit]
Description=Internet speed check (direct + SOCKS5)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ speedtest_script_path }}
# Four transfers plus the latency samples: comfortably past systemd's 90s
# default, so give the run room instead of letting it be killed mid-test.
TimeoutStartSec=600
